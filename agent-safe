#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF' >&2
usage: agent-safe [options] <target|command> [args...]
       agent-safe [project-dir]           (when invoked as pi-web-safe)

Options must come BEFORE the target; everything after it is passed
through to the target untouched (so `agent-safe claude --help` shows
Claude's help, not this one).

Runs AI coding agents in a bubblewrap sandbox where the project directory,
agent configs, and a narrow set of build tool caches are writable; everything
else read-only.

Targets / Modes:
  pi               Run Pi CLI in yolo mode
  pi-web           Run Pi Web in yolo mode (pnpx @agegr/pi-web@latest --hostname 0.0.0.0)
  agy              Run Antigravity CLI (agy --dangerously-skip-permissions)
  claude           Run Claude Code CLI (claude --dangerously-skip-permissions)
  codex            Run Codex CLI (codex --dangerously-bypass-approvals-and-sandbox)
  copilot          Run GitHub Copilot CLI (copilot --yolo)
  aider            Run Aider (aider --yes)
  opencode         Run OpenCode CLI (opencode --auto)
  shell [args...]  Run an interactive shell inside the sandbox
  run <cmd...>     Run an arbitrary command inside the sandbox

Multi-call symlink shortcuts:
  pi-safe          -> runs 'pi' mode directly
  pi-web-safe      -> runs 'pi-web' mode directly
  agy-safe         -> runs 'agy' mode directly
  claude-safe      -> runs 'claude' mode directly
  codex-safe       -> runs 'codex' mode directly
  copilot-safe     -> runs 'copilot' mode directly
  aider-safe       -> runs 'aider' mode directly
  opencode-safe    -> runs 'opencode' mode directly

Options:
  -C, --cwd <dir>    Set project working directory (default: current directory)
  -w, --write <dir>  Mount an extra directory as writable inside sandbox
  --offline, --no-net Run with network isolation (disable network access)
  --dry-run          Print sandbox configuration and bwrap command without executing
  --no-mask          Do not mask host secrets (~/.ssh, ~/.aws, etc.)
  -h, --help         Show this help message
EOF
  exit 1
}

PROG="$(basename "$0")"
TARGET=""

case "$PROG" in
  # The script's own name (agent-safe, agent-safe.sh, ...) picks nothing; without
  # this, the ".sh" of an agent-safe.sh install matched *sh* below.
  agent-safe*) TARGET="" ;;
  *pi-web*|*web*) TARGET="pi-web" ;;
  *copilot*) TARGET="copilot" ;;
  *opencode*) TARGET="opencode" ;;
  *pi*)      TARGET="pi" ;;
  *agy*)     TARGET="agy" ;;
  *claude*)  TARGET="claude" ;;
  *codex*)   TARGET="codex" ;;
  *aider*)   TARGET="aider" ;;
  *shell*|*bash*|*sh*) TARGET="shell" ;;
  *)         TARGET="" ;;
esac
PROG_TARGET="$TARGET"

MASK_SECRETS=1
if [[ "${AGENT_SAFE_NO_MASK:-0}" == "1" ]]; then
  MASK_SECRETS=0
fi

OFFLINE=0
if [[ "${AGENT_SAFE_OFFLINE:-0}" == "1" ]]; then
  OFFLINE=1
fi

PROJECT_DIR="$PWD"
EXTRA_WRITE_CLI=()
DRY_RUN=0

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      ;;
    --offline|--no-net)
      OFFLINE=1
      shift
      ;;
    --dry-run|--info)
      DRY_RUN=1
      shift
      ;;
    -C|--cwd|--dir)
      [[ $# -ge 2 ]] || { echo "agent-safe: $1 requires a directory argument" >&2; exit 1; }
      PROJECT_DIR="$2"
      shift 2
      ;;
    -w|--write|--bind)
      [[ $# -ge 2 ]] || { echo "agent-safe: $1 requires a directory argument" >&2; exit 1; }
      EXTRA_WRITE_CLI+=("$2")
      shift 2
      ;;
    --no-mask)
      MASK_SECRETS=0
      shift
      ;;
    *)
      # Invoked as claude-safe & co., the name already picked the target, so a
      # leading "run", "shell" or agent name belongs to the agent
      # (`opencode-safe run "..."`), not to us.
      [[ -z "$PROG_TARGET" ]] || break
      case "$1" in
        --pi|pi)                     TARGET="pi" ;;
        --pi-web|pi-web|--web|web)   TARGET="pi-web" ;;
        --agy|agy)                   TARGET="agy" ;;
        --claude|claude)             TARGET="claude" ;;
        --codex|codex)               TARGET="codex" ;;
        --copilot|copilot)           TARGET="copilot" ;;
        --aider|aider)               TARGET="aider" ;;
        --opencode|opencode)         TARGET="opencode" ;;
        shell|bash|sh)               TARGET="shell" ;;
        run|--)                      TARGET="raw" ;;
        *)                           break ;;
      esac
      shift
      break
      ;;
  esac
done

if [[ -z "$TARGET" ]]; then
  usage
fi

# In pi-web mode, first positional non-flag argument can be project directory
if [[ "$TARGET" == "pi-web" && $# -gt 0 && "$1" != -* ]]; then
  PROJECT_DIR="$1"
  shift
fi
# Resolve into a temporary, or the failed assignment would blank $PROJECT_DIR
# before the error message gets to name it.
if ! project_dir_real="$(realpath -e -- "$PROJECT_DIR" 2>/dev/null)"; then
  echo "agent-safe: cannot resolve project dir: $PROJECT_DIR" >&2
  exit 1
fi
PROJECT_DIR="$project_dir_real"

# A writable $HOME (or anything above it) makes shell rc files, ~/.local/bin,
# ~/.config/autostart and every agent's hooks fair game, but warn rather than refuse.
home_real="$(realpath -q -- "${HOME:?agent-safe: HOME is not set}")" || home_real="$HOME"
if [ "$PROJECT_DIR" = / ] || [ "${home_real#"$PROJECT_DIR"/}" != "$home_real" ] || [ "$PROJECT_DIR" = "$home_real" ]; then
  echo "agent-safe: warning: making $PROJECT_DIR writable; it is your home directory or one of its parents" >&2
fi

can_sandbox() {
  [[ "${AGENT_SAFE:-0}" == "1" ]] && return 1
  command -v bwrap >/dev/null 2>&1 && bwrap --ro-bind / / true >/dev/null 2>&1
}
SANDBOX_OK=1
can_sandbox || SANDBOX_OK=0

# Fail closed, and before anything below touches agent settings or repo files.
# Every target runs with its permission prompts off (and claude's and agy's own
# sandboxes disabled), which is only acceptable inside bwrap. A dry run still
# prints what it would do.
if [[ "$SANDBOX_OK" -eq 0 && "${AGENT_SAFE:-0}" != "1" && "${AGENT_SAFE_ALLOW_UNSANDBOXED:-0}" != "1" && "$DRY_RUN" -eq 0 ]]; then
  if ! command -v bwrap >/dev/null 2>&1; then
    echo "agent-safe: bwrap not found; install bubblewrap" >&2
  else
    echo "agent-safe: bwrap cannot create a sandbox here (inside a container, or unprivileged user namespaces disabled)" >&2
  fi
  echo "agent-safe: refusing to run unsandboxed; set AGENT_SAFE_ALLOW_UNSANDBOXED=1 to override" >&2
  exit 1
fi
: "${HOME:?agent-safe: HOME is not set}"

RUN_CMD=()
ENABLE_PI_YOLO=false

case "$TARGET" in
  pi)
    command -v pi >/dev/null 2>&1 || { echo "agent-safe: 'pi' not found in PATH" >&2; exit 1; }
    case "${1:-}" in
      install|remove|uninstall|update|list|config)
        has_approve=0
        for arg in "${@:2}"; do
          case "$arg" in
            -a|--approve|-na|--no-approve) has_approve=1; break ;;
          esac
        done
        if [[ "$has_approve" -eq 1 ]]; then
          RUN_CMD=(pi "$@")
        else
          RUN_CMD=(pi "$1" --approve "${@:2}")
        fi
        ;;
      auth|-h|--help|-v|--version)
        RUN_CMD=(pi "$@")
        ;;
      *)
        ENABLE_PI_YOLO=true
        has_approve=0
        for arg in "$@"; do
          case "$arg" in
            -a|--approve|-na|--no-approve) has_approve=1; break ;;
          esac
        done
        if [[ "$has_approve" -eq 1 ]]; then
          RUN_CMD=(pi "$@")
        else
          RUN_CMD=(pi --approve "$@")
        fi
        ;;
    esac
    ;;
  pi-web)
    command -v pnpx >/dev/null 2>&1 || { echo "agent-safe: 'pnpx' not found in PATH" >&2; exit 1; }
    ENABLE_PI_YOLO=true
    RUN_CMD=(pnpx --allow-build=@google/genai --allow-build=esbuild --allow-build=node-pty --allow-build=protobufjs "@agegr/pi-web@latest" --hostname 0.0.0.0 "$@")
    ;;
  agy)
    command -v agy >/dev/null 2>&1 || { echo "agent-safe: 'agy' not found in PATH" >&2; exit 1; }
    RUN_CMD=(agy --dangerously-skip-permissions "$@")
    ;;
  claude)
    command -v claude >/dev/null 2>&1 || { echo "agent-safe: 'claude' not found in PATH" >&2; exit 1; }
    RUN_CMD=(claude --dangerously-skip-permissions --settings '{"sandbox":{"enabled":false}}' "$@")
    ;;
  codex)
    command -v codex >/dev/null 2>&1 || { echo "agent-safe: 'codex' not found in PATH" >&2; exit 1; }
    RUN_CMD=(codex --dangerously-bypass-approvals-and-sandbox "$@")
    ;;
  copilot)
    command -v copilot >/dev/null 2>&1 || { echo "agent-safe: 'copilot' not found in PATH" >&2; exit 1; }
    RUN_CMD=(copilot --yolo "$@")
    ;;
  aider)
    command -v aider >/dev/null 2>&1 || { echo "agent-safe: 'aider' not found in PATH" >&2; exit 1; }
    RUN_CMD=(aider --yes "$@")
    ;;
  opencode)
    command -v opencode >/dev/null 2>&1 || { echo "agent-safe: 'opencode' not found in PATH" >&2; exit 1; }
    case "${1:-}" in
      run)
        has_auto=0
        for arg in "${@:2}"; do
          case "$arg" in
            --auto) has_auto=1; break ;;
          esac
        done
        if [[ "$has_auto" -eq 1 ]]; then
          RUN_CMD=(opencode "$@")
        else
          RUN_CMD=(opencode run --auto "${@:2}")
        fi
        ;;
      completion|acp|mcp|attach|debug|providers|auth|agent|upgrade|uninstall|serve|web|models|stats|export|import|github|pr|session|plugin|plug|db|-h|--help|-v|--version)
        RUN_CMD=(opencode "$@")
        ;;
      *)
        has_auto=0
        for arg in "$@"; do
          case "$arg" in
            --auto) has_auto=1; break ;;
          esac
        done
        if [[ "$has_auto" -eq 1 ]]; then
          RUN_CMD=(opencode "$@")
        else
          RUN_CMD=(opencode --auto "$@")
        fi
        ;;
    esac
    ;;
  shell)
    user_shell="${SHELL:-/bin/bash}"
    if [[ $# -gt 0 ]]; then
      RUN_CMD=("$user_shell" "$@")
    else
      RUN_CMD=("$user_shell" "-i")
    fi
    ;;
  raw)
    if [[ $# -eq 0 ]]; then
      echo "agent-safe run: no command specified" >&2
      exit 1
    fi
    RUN_CMD=("$@")
    ;;
esac

case "$TARGET" in
  pi|pi-web) mkdir -p "$HOME/.pi" 2>/dev/null || true ;;
  agy)       mkdir -p "$HOME/.gemini" 2>/dev/null || true ;;
  claude)    mkdir -p "$HOME/.claude" 2>/dev/null || true ;;
  codex)     mkdir -p "$HOME/.codex" 2>/dev/null || true ;;
  copilot)   mkdir -p "$HOME/.copilot" 2>/dev/null || true ;;
  aider)     mkdir -p "$HOME/.aider" 2>/dev/null || true ;;
  opencode)  mkdir -p "$HOME/.config/opencode" "$HOME/.local/share/opencode" "$HOME/.local/state/opencode" "$HOME/.cache/opencode" 2>/dev/null || true ;;
esac
PI_DIR="$(realpath ~/.pi 2>/dev/null || echo "$HOME/.pi")"
PERM_CONFIG="$PI_DIR/agent/extensions/pi-permission-system/config.json"

set_yolo_mode() {
  local mode="$1"
  if [[ -f "$PERM_CONFIG" ]] && command -v jq >/dev/null 2>&1; then
    local tmp_file
    tmp_file="$(mktemp "${PERM_CONFIG}.tmp.XXXXXX" 2>/dev/null || mktemp)" || return 1
    if jq --argjson val "$mode" '.yoloMode = $val' "$PERM_CONFIG" > "$tmp_file" 2>/dev/null; then
      mv "$tmp_file" "$PERM_CONFIG"
    else
      rm -f "$tmp_file"
    fi
  fi
}

# yoloMode is global state in a shared config file, so concurrent pi sessions have
# to be reference counted: without this the first session to exit turns yoloMode
# off underneath every session still running. One marker file per live session,
# named by pid so a session killed with -9 can be reaped by the next one.
YOLO_RUN_DIR="$PI_DIR/.agent-safe-yolo"
YOLO_MARKER=""

yolo_live_sessions() {
  local marker pid count=0
  for marker in "$YOLO_RUN_DIR"/*; do
    [ -f "$marker" ] || continue
    pid="${marker##*/}"
    # Anything not named after a pid is bookkeeping (the "prior" file), not a session.
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$marker"
      continue
    fi
    count=$((count + 1))
  done
  echo "$count"
}

AGY_SETTINGS="$HOME/.gemini/antigravity-cli/settings.json"
AGY_CONFIG="$HOME/.gemini/config/config.json"
AGY_RUN_DIR="$HOME/.gemini/.agent-safe-agy"
AGY_MARKER=""

disable_agy_terminal_sandbox() {
  command -v jq >/dev/null 2>&1 || return 0
  local tmp_file
  if [[ -f "$AGY_SETTINGS" ]]; then
    tmp_file="$(mktemp "${AGY_SETTINGS}.tmp.XXXXXX" 2>/dev/null || mktemp)" || true
    if [[ -n "$tmp_file" ]]; then
      if jq '.enableTerminalSandbox = false' "$AGY_SETTINGS" > "$tmp_file" 2>/dev/null; then
        mv "$tmp_file" "$AGY_SETTINGS"
      else
        rm -f "$tmp_file"
      fi
    fi
  fi
  if [[ -f "$AGY_CONFIG" ]]; then
    tmp_file="$(mktemp "${AGY_CONFIG}.tmp.XXXXXX" 2>/dev/null || mktemp)" || true
    if [[ -n "$tmp_file" ]]; then
      if jq 'if has("userSettings") then .userSettings.enableTerminalSandbox = false else . end' "$AGY_CONFIG" > "$tmp_file" 2>/dev/null; then
        mv "$tmp_file" "$AGY_CONFIG"
      else
        rm -f "$tmp_file"
      fi
    fi
  fi
}

restore_agy_terminal_sandbox() {
  [ -f "$AGY_RUN_DIR/prior" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  local prior_settings prior_config tmp_file
  {
    IFS= read -r prior_settings || true
    IFS= read -r prior_config || true
  } < "$AGY_RUN_DIR/prior"

  if [[ -f "$AGY_SETTINGS" ]]; then
    tmp_file="$(mktemp "${AGY_SETTINGS}.tmp.XXXXXX" 2>/dev/null || mktemp)" || true
    if [[ -n "$tmp_file" ]]; then
      local jq_filter
      if [[ "$prior_settings" == "unset" ]]; then
        jq_filter='del(.enableTerminalSandbox)'
      elif [[ "$prior_settings" == "true" || "$prior_settings" == "false" ]]; then
        jq_filter=".enableTerminalSandbox = $prior_settings"
      else
        jq_filter=""
      fi
      if [[ -n "$jq_filter" ]] && jq "$jq_filter" "$AGY_SETTINGS" > "$tmp_file" 2>/dev/null; then
        mv "$tmp_file" "$AGY_SETTINGS"
      else
        rm -f "$tmp_file"
      fi
    fi
  fi

  if [[ -f "$AGY_CONFIG" ]]; then
    tmp_file="$(mktemp "${AGY_CONFIG}.tmp.XXXXXX" 2>/dev/null || mktemp)" || true
    if [[ -n "$tmp_file" ]]; then
      local jq_filter
      if [[ "$prior_config" == "unset" ]]; then
        jq_filter='if has("userSettings") then del(.userSettings.enableTerminalSandbox) else . end'
      elif [[ "$prior_config" == "true" || "$prior_config" == "false" ]]; then
        jq_filter="if has(\"userSettings\") then .userSettings.enableTerminalSandbox = $prior_config else . end"
      else
        jq_filter=""
      fi
      if [[ -n "$jq_filter" ]] && jq "$jq_filter" "$AGY_CONFIG" > "$tmp_file" 2>/dev/null; then
        mv "$tmp_file" "$AGY_CONFIG"
      else
        rm -f "$tmp_file"
      fi
    fi
  fi
  rm -f "$AGY_RUN_DIR/prior"
}

agy_live_sessions() {
  local marker pid count=0
  for marker in "$AGY_RUN_DIR"/*; do
    [ -f "$marker" ] || continue
    pid="${marker##*/}"
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$marker"
      continue
    fi
    count=$((count + 1))
  done
  echo "$count"
}

IDE_LOCK_SNAPSHOTS=()

cleanup() {
  trap - EXIT INT TERM
  if [ "${#IDE_LOCK_SNAPSHOTS[@]}" -gt 0 ]; then
    rm -rf "${IDE_LOCK_SNAPSHOTS[@]}"
    IDE_LOCK_SNAPSHOTS=()
  fi
  if [ -n "$YOLO_MARKER" ]; then
    rm -f "$YOLO_MARKER"
    YOLO_MARKER=""
    # Restore only once the last session is gone, and only to what we found.
    if [ "$(yolo_live_sessions)" -eq 0 ] && [ -f "$YOLO_RUN_DIR/prior" ]; then
      set_yolo_mode "$(cat "$YOLO_RUN_DIR/prior")"
      rm -f "$YOLO_RUN_DIR/prior"
    fi
  fi
  if [ -n "$AGY_MARKER" ]; then
    rm -f "$AGY_MARKER"
    AGY_MARKER=""
    if [ "$(agy_live_sessions)" -eq 0 ]; then
      restore_agy_terminal_sandbox
    fi
  fi
}

if [[ "$ENABLE_PI_YOLO" == true ]]; then
  if mkdir -p "$YOLO_RUN_DIR" 2>/dev/null; then
    # Snapshot only when no record survives. A leftover "prior" with no live
    # session means an earlier run was killed before it could restore; that file
    # still holds the untouched value, while the config now holds ours.
    if [ ! -f "$YOLO_RUN_DIR/prior" ]; then
      # Remember whether the user already had yoloMode on, so we hand it back
      # instead of hardcoding false.
      prior=false
      if [[ -f "$PERM_CONFIG" ]] && command -v jq >/dev/null 2>&1; then
        prior="$(jq -r 'if .yoloMode == true then "true" else "false" end' "$PERM_CONFIG" 2>/dev/null || echo false)"
      fi
      printf '%s' "$prior" > "$YOLO_RUN_DIR/prior" 2>/dev/null || true
    fi
    YOLO_MARKER="$YOLO_RUN_DIR/$$"
    : > "$YOLO_MARKER" 2>/dev/null || YOLO_MARKER=""
  fi
  trap cleanup EXIT INT TERM
  set_yolo_mode true
fi

if [[ "$TARGET" == "agy" ]]; then
  if mkdir -p "$AGY_RUN_DIR" 2>/dev/null; then
    if [ ! -f "$AGY_RUN_DIR/prior" ]; then
      prior_settings="unset"
      if [[ -f "$AGY_SETTINGS" ]] && command -v jq >/dev/null 2>&1; then
        prior_settings="$(jq -r 'if has("enableTerminalSandbox") then (.enableTerminalSandbox | tostring) else "unset" end' "$AGY_SETTINGS" 2>/dev/null || echo unset)"
      fi
      prior_config="unset"
      if [[ -f "$AGY_CONFIG" ]] && command -v jq >/dev/null 2>&1; then
        prior_config="$(jq -r 'if .userSettings? | has("enableTerminalSandbox") then (.userSettings.enableTerminalSandbox | tostring) else "unset" end' "$AGY_CONFIG" 2>/dev/null || echo unset)"
      fi
      printf '%s\n%s\n' "$prior_settings" "$prior_config" > "$AGY_RUN_DIR/prior" 2>/dev/null || true
    fi
    AGY_MARKER="$AGY_RUN_DIR/$$"
    : > "$AGY_MARKER" 2>/dev/null || AGY_MARKER=""
  fi
  trap cleanup EXIT INT TERM
  disable_agy_terminal_sandbox
fi

# Writable paths for build tooling and agent configs.
#
# These are deliberately narrow: only directories holding downloaded artifacts
# and compiled output, never a tool's root directory. Roots such as ~/.cargo,
# ~/.local/share or ~/.nvm hold executables that are on your PATH, and config
# that runs on the next build (~/.cargo/config.toml, ~/.gradle/init.d,
# ~/.m2/settings.xml). Making those writable would let the agent plant code
# that later runs OUTSIDE the sandbox, which defeats the point of agent-safe.
CACHE_DIRS=(
  # Agent config: extensions, settings, auth, session history
  "$HOME/.pi"
  "$HOME/.gemini"
  "$HOME/.claude"
  "$HOME/.claude.json"
  "$HOME/.config/claude"
  "$HOME/.codex"
  "$HOME/.config/codex"
  "$HOME/.copilot"
  "$HOME/.config/copilot"
  "$HOME/.config/github-copilot"
  "$HOME/.aider"
  "$HOME/.aider.conf.yml"
  "$HOME/.aider.chat.history.md"
  "$HOME/.opencode"
  "$HOME/.config/opencode"
  "$HOME/.local/share/opencode"
  "$HOME/.local/state/opencode"
  "$HOME/.cache/opencode"
  # Claude Code's own shell snapshots and MCP logs.
  "$HOME/.cache/claude-cli-nodejs"

  # JVM (repository and caches; wrapper dists left read-only to prevent executable poisoning)
  "$HOME/.m2/repository"
  "$HOME/.gradle/caches"
  "$HOME/.gradle/native"
  "$HOME/.gradle/workers"
  "$HOME/.gradle/.tmp"
  "$HOME/.gradle/kotlin-profile"
  "$HOME/.gradle/android"
  "$HOME/.gradle/notifications"
  "$HOME/.gradle/build-scans"
  "$HOME/.gradle/develocity"
  "$HOME/.gradle/enterprise"
  "$HOME/.ivy2/cache"
  "$HOME/.cache/coursier"
  # java.util.prefs and the AWT font cache; the JVM throws on a read-only one.
  "$HOME/.java/.userPrefs"
  "$HOME/.java/fonts"
  "$HOME/.groovy/grapes"
  "$HOME/.cache/JNA"
  # Android Gradle builds: debug.keystore, the AVDs and the build cache.
  "$HOME/.android"

  # Rust
  "$HOME/.cargo/registry"
  "$HOME/.cargo/git"

  # Go
  "$HOME/go/pkg/mod"
  "$HOME/.cache/go-build"

  # Node & Web
  "$HOME/.npm/_cacache"
  "$HOME/.npm/_logs"
  "$HOME/.pnpm-store"
  # pnpm's store and metadata cache. Only store/ and not the whole data dir:
  # ${XDG_DATA_HOME}/pnpm is PNPM_HOME, whose globally installed shims are on
  # your PATH and run outside the sandbox.
  "${XDG_CACHE_HOME:-$HOME/.cache}/pnpm"
  "${XDG_DATA_HOME:-$HOME/.local/share}/pnpm/store"
  "${XDG_STATE_HOME:-$HOME/.local/state}/pnpm"
  "$HOME/.cache/yarn"
  "$HOME/.yarn/berry/cache"
  "$HOME/.bun/install/cache"
  "$HOME/.cache/deno"
  "$HOME/.cache/node-gyp"
  "$HOME/.cache/ms-playwright"
  "$HOME/.cache/ms-playwright-go"
  "$HOME/.cache/cypress"
  "$HOME/.cache/turbo"
  "$HOME/.cache/typescript"

  # Python & Linters
  "$HOME/.cache/pip"
  "$HOME/.cache/uv"
  "$HOME/.cache/pypoetry"
  "$HOME/.cache/pdm"
  "$HOME/.cache/matplotlib"

  # Model weights
  "$HOME/.cache/huggingface"

  # Linters and formatters that keep an incremental cache
  "$HOME/.cache/ruff"
  "$HOME/.cache/mypy"
  "$HOME/.cache/golangci-lint"
  "$HOME/.cache/biome"
  "$HOME/.cache/dprint"
  "$HOME/.cache/zig"

  # .NET, PHP, Dart, Ruby, Haskell, Elixir
  "$HOME/.nuget/packages"
  "$HOME/.cache/composer"
  "$HOME/.pub-cache/hosted"
  "$HOME/.pub-cache/git"
  "$HOME/.gem/cache"
  "$HOME/.cabal/packages"
  "$HOME/.stack/pantry"
  "$HOME/.hex/packages"

  # Compiler caches (C/C++/Rust object caches, keyed by content hash)
  "${CCACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/ccache}"
  "$HOME/.ccache"
  "$HOME/.cache/sccache"

  # Version manager download caches (not the installed toolchains)
  "$HOME/.cache/mise"

  # Regenerated on demand by headless browsers, the JVM and matplotlib; a
  # read-only one means a slow rebuild on every single run.
  "$HOME/.cache/fontconfig"
  "$HOME/.cache/mesa_shader_cache"
)

# Lock and index files that a tool creates in an otherwise read-only root, so
# they cannot be pre-created by the mkdir pass below without turning into
# directories. cargo takes an exclusive flock on $CARGO_HOME/.package-cache for
# every command that touches the registry, so a read-only CARGO_HOME fails the
# build even with registry/ and git/ writable.
CACHE_FILES=(
  "$HOME/.cargo/.package-cache"
  "$HOME/.cargo/.package-cache-mutate"
  "$HOME/.cargo/.global-cache"
)

# Left read-only on purpose:
#   ~/.local/share       .desktop files, systemd user units, mise/pipx installs
#   ~/.cache/pre-commit  hook environments, executed by git outside the sandbox
#   ~/.nvm ~/.pyenv ~/.asdf ~/.sdkman ~/.rustup ~/.cargo/bin ~/.bun/bin
#                        interpreters and shims that are on your PATH
#   ~/.gradle/wrapper ~/.m2/wrapper
#                        downloaded wrappers containing shell scripts/executables
# Installing a toolchain or a global CLI therefore has to happen outside agent-safe.

# User-provided extra write mounts from CLI flags (-w / --write) and AGENT_SAFE_WRITE.
# These have the last say and are applied AFTER all masks and read-only protections.
USER_WRITE_DIRS=()
if [[ ${#EXTRA_WRITE_CLI[@]} -gt 0 ]]; then
  USER_WRITE_DIRS+=("${EXTRA_WRITE_CLI[@]}")
fi

EXTRA_WRITE="${AGENT_SAFE_WRITE:-}"
if [ -n "$EXTRA_WRITE" ]; then
  IFS=':' read -r -a extra_write_dirs <<<"$EXTRA_WRITE"
  USER_WRITE_DIRS+=("${extra_write_dirs[@]}")
fi

USER_WRITE_ARGS=()
user_bound=""

add_user_write() {
  local path="$1" real parent
  path="${path/#\~/$HOME}"
  if [ ! -e "$path" ]; then
    parent="$(dirname "$path")"
    if [ -d "$parent" ]; then
      mkdir -p "$path" 2>/dev/null || true
    fi
  fi
  real="$(realpath -q "$path")" || return 0
  [ -e "$real" ] || return 0
  case ":$user_bound:" in *":$real:"*) return 0 ;; esac
  user_bound="$user_bound:$real"
  USER_WRITE_ARGS+=(--bind "$real" "$real")
}

if [[ ${#USER_WRITE_DIRS[@]} -gt 0 ]]; then
  for dir in "${USER_WRITE_DIRS[@]}"; do
    add_user_write "$dir"
  done
fi

BIND_ARGS=()
bound=""

add_bind() {
  local path="$1" mode="${2:---bind}" real
  real="$(realpath -q "$path")" || return 0
  [ -e "$real" ] || return 0
  case ":$bound:" in *":$mode $real:"*) return 0 ;; esac
  bound="$bound:$mode $real"
  BIND_ARGS+=("$mode" "$real" "$real")
}

for dir in "${CACHE_DIRS[@]}"; do
  # Create a cache dir only when its tool is already installed, i.e. when the
  # parent exists, so agent-safe never litters $HOME for tools you do not use.
  parent="$(dirname "$dir")"
  if [ ! -e "$dir" ] && [ "$parent" != "$HOME" ] && [ "$parent" != "$HOME/.config" ] && [ -d "$parent" ]; then
    mkdir -p "$dir" 2>/dev/null || true
  fi
  add_bind "$dir"
done

for file in "${CACHE_FILES[@]}"; do
  parent="$(dirname "$file")"
  if [ ! -e "$file" ] && [ -d "$parent" ]; then
    : > "$file" 2>/dev/null || true
  fi
  add_bind "$file"
done

# Git hooks are executed by git ON THE HOST the next time you run a git command in
# this repo, so keep hooks/ read-only in every repo layout. Nothing legitimately
# writes it, and an agent that drops a script there escapes the sandbox by accident.
#
# .git/config is read-only for the same reason. Marking only hooks/ read-only does
# not close the hole: core.hooksPath redirects hook lookup somewhere else entirely,
# and core.sshCommand, core.pager, core.editor, alias.*, filter.*.clean/smudge and
# diff.*.textconv all name commands that git runs ON THE HOST. The cost is that
# `git config` and `git remote add` fail inside the sandbox; run them outside.
# Submodule gitdirs under .git/modules/, linked worktree gitdirs under
# .git/worktrees/ and embedded .git directories inside the project get the same
# treatment.
#
# For worktrees and repo subdirectories the real .git is outside $PROJECT_DIR and
# also has to be bound writable, or git refuses to commit.
#
# Read-only binds alone do not survive the agent renaming a gitdir out of the way:
# mounts travel with a renamed directory, so `mv .git .git-old` (or `mv
# .git/modules/sub ...`) followed by a fresh config setting core.fsmonitor hands
# the host's next `git status` a command to run. rename() refuses to move a
# mountpoint, so every gitdir is also bound onto itself, writable since git still
# has to commit, and so is every directory between it and the writable bind it
# lives in: rename() does move a directory that merely contains a mountpoint, so
# `mv libs libs-old` would carry a pinned libs/sub along and leave a fresh
# libs/sub/.git to be written. Where .git is a "gitdir:" pointer file (linked
# worktrees, submodules) the pointer is bound read-only instead, with its checkout
# pinned the same way. The writable binds themselves need no pin: being a bind
# already makes each a mountpoint, and anything above them is read-only.
GIT_RO_ARGS=()
GIT_PIN_ARGS=()
git_ro_paths=()
git_pin_paths=()
git_writable_roots=("$PROJECT_DIR")
git_protected=""
git_pinned=""

# Everything walked below sits in agent-writable directories, so any of it may be a
# symlink planted in an earlier session: `.git/modules -> ~/.local` would have us
# write into ~/.local and, since bwrap follows a symlink at a mount destination,
# pin it writable. Only a path that is its own realpath, with no symlink anywhere
# along it, is trusted.
git_resolved() {
  [ "$(realpath -q -- "$1")" = "$1" ] && return 0
  echo "agent-safe: not protecting $1: it is or passes through a symlink" >&2
  return 1
}

# Pins $1 and every directory between it and the writable bind holding it. Returns
# 1 when $1 is not strictly inside a writable bind, i.e. when the sandbox cannot
# write it anyway, or when it is not a resolved path.
git_pin() {
  local root cur part
  git_resolved "$1" || return 1
  for root in "${git_writable_roots[@]}"; do
    case "$1" in "$root"/*) ;; *) continue ;; esac
    cur="$root"
    while IFS= read -r -d / part; do
      cur="$cur/$part"
      git_pin_paths+=("$cur")
    done < <(printf '%s/' "${1#"$root"/}")
    return 0
  done
  return 1
}

# Protects one gitdir, resolved, and every gitdir it holds.
protect_gitdir() {
  local gitdir="$1" wt_config=false wt_dir root common
  case ":$git_protected:" in *":$gitdir:"*) return 0 ;; esac
  git_protected="$git_protected:$gitdir"
  git_resolved "$gitdir" || return 0
  # A writable bind root is already a mountpoint; anything outside one is read-only.
  for root in "${git_writable_roots[@]}"; do
    [ "$gitdir" = "$root" ] && break
  done
  [ "$gitdir" = "$root" ] || git_pin "$gitdir" || return 0
  if [ -f "$gitdir/commondir" ]; then
    git_ro_paths+=("$gitdir/commondir")
    # One that points elsewhere makes this a linked worktree's gitdir, which its
    # common dir takes care of; one pointing back here is ours, from an earlier run.
    common="$(head -n 1 "$gitdir/commondir" 2>/dev/null)"
    common="$(cd "$gitdir" && realpath -q -- "${common%$'\r'}")" || return 0
    [ "$common" = "$gitdir" ] || return 0
  fi
  # git reads $GIT_DIR/commondir in ANY gitdir, not just a linked worktree's, and
  # takes config, hooks and everything else from the directory it names. An agent
  # writing one into .git would bypass every read-only bind here, so give each
  # common dir a commondir of its own, pointing at itself, and bind it read-only.
  # An empty or unreadable commondir makes git die, so it has to hold ".".
  [ -e "$gitdir/commondir" ] || [ -L "$gitdir/commondir" ] ||
    printf '.\n' > "$gitdir/commondir" 2>/dev/null || true
  mkdir -p "$gitdir/hooks" 2>/dev/null || true
  git_ro_paths+=("$gitdir/commondir" "$gitdir/config" "$gitdir/config.worktree" "$gitdir/hooks")
  # A linked worktree's own gitdir holds a second config file, and core.hooksPath
  # set there is honored just as it is in the common config. It only counts when
  # extensions.worktreeConfig is on, and that flag lives in the config we just
  # made read-only, so it cannot be switched on from inside the sandbox; when it
  # is already on, every worktree needs the same treatment. Create the file where
  # it is missing, or there is nothing to bind over and the agent can write a
  # fresh one. `git sparse-checkout set` turns the extension on by itself, so
  # this is not an exotic setup.
  if [ "$(git config -f "$gitdir/config" --get extensions.worktreeConfig 2>/dev/null)" = true ]; then
    wt_config=true
    [ -e "$gitdir/config.worktree" ] || [ -L "$gitdir/config.worktree" ] ||
      : > "$gitdir/config.worktree" 2>/dev/null || true
  fi
  for wt_dir in "$gitdir"/worktrees/*/; do
    wt_dir="${wt_dir%/}"
    [ -d "$wt_dir" ] || continue
    git_pin "$wt_dir" || continue
    # commondir is what makes it a worktree of this repo; rewritten, it would point
    # the worktree at any config the agent likes.
    git_ro_paths+=("$wt_dir/commondir")
    if [ "$wt_config" = true ]; then
      [ -e "$wt_dir/config.worktree" ] || [ -L "$wt_dir/config.worktree" ] ||
        : > "$wt_dir/config.worktree" 2>/dev/null || true
      git_ro_paths+=("$wt_dir/config.worktree")
    fi
  done
  if [ -d "$gitdir/modules" ]; then
    walk_git_modules "$gitdir/modules"
  fi
}

# Submodule gitdirs live at modules/<name>, and a name may contain slashes, so a
# directory without a HEAD is one more component of a name rather than a gitdir.
walk_git_modules() {
  local dir
  git_resolved "$1" || return 0
  for dir in "$1"/*/ "$1"/.[!.]*/; do
    dir="${dir%/}"
    [ -d "$dir" ] || continue
    git_resolved "$dir" || continue
    if [ -f "$dir/HEAD" ]; then
      protect_gitdir "$dir"
    else
      walk_git_modules "$dir"
    fi
  done
}

# Pins a checkout's .git, and those of its submodules, nested ones included.
pin_git_checkout() {
  local dir dotgit sub_path
  dir="$(realpath -q "$1")" || return 0
  [ -d "$dir" ] || return 0
  case ":$git_pinned:" in *":$dir:"*) return 0 ;; esac
  git_pinned="$git_pinned:$dir"
  case "$dir/" in
    "$PROJECT_DIR"/*)
      dotgit="$dir/.git"
      # bwrap follows a symlink at a mount destination, and the paths that lead here
      # (.gitmodules, .git/worktrees/*/gitdir) are all agent-writable: a planted
      # `.git -> ../../.local/bin` would turn a writable pin into a writable
      # ~/.local/bin. A real .git is never a symlink, so leave such a checkout alone.
      if [ -L "$dotgit" ]; then
        echo "agent-safe: not pinning $dotgit: it is a symlink" >&2
        return 0
      fi
      if [ -d "$dotgit" ]; then
        protect_gitdir "$dotgit"
      elif [ -f "$dotgit" ]; then
        git_pin "$dir" || true
        git_ro_paths+=("$dotgit")
      fi
      ;;
    *)
      # A repo the project is a subdirectory of: its .git is not ours to pin, but
      # submodules inside the project still are.
      case "$PROJECT_DIR/" in "$dir"/*) ;; *) return 0 ;; esac
      ;;
  esac
  # .gitmodules is only read for paths here, and anything it names outside
  # $PROJECT_DIR (and not holding it) is dropped by the checks above.
  [ -f "$dir/.gitmodules" ] || return 0
  while IFS= read -r sub_path; do
    if [ -e "$dir/$sub_path/.git" ]; then
      pin_git_checkout "$dir/$sub_path"
    fi
  done < <(git config -f "$dir/.gitmodules" --get-regexp '^submodule\..*\.path$' 2>/dev/null | cut -d' ' -f2-)
}

if git_common="$(git -C "$PROJECT_DIR" rev-parse --git-common-dir 2>/dev/null)"; then
  git_common="$(cd "$PROJECT_DIR" && realpath -q "$git_common")" || git_common=""
  if [ -n "$git_common" ]; then
    if [ "${git_common#"$PROJECT_DIR"/}" = "$git_common" ]; then
      add_bind "$git_common"
      git_writable_roots+=("$git_common")
    fi
    protect_gitdir "$git_common"
  fi
  if git_top="$(git -C "$PROJECT_DIR" rev-parse --show-toplevel 2>/dev/null)"; then
    pin_git_checkout "$git_top"
  fi
  # Linked worktrees that live inside the project carry a writable pointer file too.
  while IFS= read -r wt_line; do
    case "$wt_line" in "worktree "*) pin_git_checkout "${wt_line#worktree }" ;; esac
  done < <(git -C "$PROJECT_DIR" worktree list --porcelain 2>/dev/null)

  # Pins go first, parents before children (which a byte-order sort gives), so no
  # pin covers another mount; bwrap binds from the host side, so a later bind of a
  # parent would hide everything mounted beneath it. The read-only binds follow,
  # and all of this is applied after the $PROJECT_DIR bind, which would otherwise
  # re-expose it as writable.
  if [ ${#git_pin_paths[@]} -gt 0 ]; then
    while IFS= read -r -d '' git_pin_path; do
      GIT_PIN_ARGS+=(--bind "$git_pin_path" "$git_pin_path")
    done < <(printf '%s\0' "${git_pin_paths[@]}" | LC_ALL=C sort -zu)
  fi
  git_ro_bound=""
  for git_ro in "${git_ro_paths[@]}"; do
    # A symlink cannot be mounted over, only its target, and the symlink itself
    # stays replaceable (`.git/hooks -> ../githooks` is the usual case).
    if [ -L "$git_ro" ]; then
      echo "agent-safe: warning: $git_ro is a symlink; the sandbox can replace it with its own" >&2
    fi
    git_ro="$(realpath -q "$git_ro")" || continue
    [ -e "$git_ro" ] || continue
    case ":$git_ro_bound:" in *":$git_ro:"*) continue ;; esac
    git_ro_bound="$git_ro_bound:$git_ro"
    GIT_RO_ARGS+=(--ro-bind "$git_ro" "$git_ro")
  done
fi

# Claude Code's IDE integration: the editor extension publishes its WebSocket port,
# auth token and its OWN pid to ~/.claude/ide/<port>.lock, and the CLI reaps every
# lockfile whose recorded pid is not alive. That pid belongs to a host process, which
# does not exist in the sandbox's PID namespace, so a sandboxed agent decides every
# running editor is dead and DELETES the lockfiles -- taking the integration down for
# host sessions too, until the editor window is reloaded. Read-only makes the reaper's
# unlink fail harmlessly (it logs and carries on) while discovery still matches on
# CLAUDE_CODE_SSE_PORT or the workspace folder, so the connection itself still works.
# It also stops the agent planting a lockfile of its own, which would aim a host
# session's IDE connection at a WebSocket server the agent controls.
IDE_RO_ARGS=()
if [ -d "$HOME/.claude" ]; then
  mkdir -p "$HOME/.claude/ide" 2>/dev/null || true
fi

# Read-only is not enough on its own, though: the lockfile is also how OTHER agents
# find the editor. pi's IDE extension here reads the very same ~/.claude/ide/<port>.lock
# and drops any lock whose recorded pid is not alive, with no CLAUDE_CODE_SSE_PORT
# escape hatch of its own -- so inside the PID namespace it decides every editor is
# gone and reports VS Code disconnected. The dir therefore gets the same sanitized
# snapshot treatment as pi's own lock dirs (see snapshot_ide_lock_dir below), which
# also leaves claude's CLAUDE_CODE_SSE_PORT path untouched: that one matches on the
# port in the filename and never looks at the pid.
claude_ide_dir=""
if ! claude_ide_dir="$(realpath -q "$HOME/.claude/ide")" || [ ! -d "$claude_ide_dir" ]; then
  claude_ide_dir=""
fi

# Keeping the lockfile is necessary but not sufficient. When it thinks it is in an
# editor terminal, the CLI only accepts a lockfile whose port equals
# CLAUDE_CODE_SSE_PORT; for any other lockfile it demands that the recorded pid be
# alive AND an ancestor of itself, which no host pid can be inside the sandbox's PID
# namespace. The extension does export CLAUDE_CODE_SSE_PORT into its terminals, but
# it picks a fresh port every activation, so after a window reload the variable in an
# already-open terminal names a port nothing listens on any more -- and then the
# sandboxed CLI falls through to the pid test and finds no IDE at all.
#
# agent-safe still runs on the host here, where pids are visible, so it can do the
# matching the sandboxed CLI cannot and hand over the answer: resolve the lockfile
# for this project itself and pin CLAUDE_CODE_SSE_PORT to that port. Newest lockfile
# first, which is the order the CLI itself prefers them in.
resolve_claude_ide_port() {
  [ -n "$claude_ide_dir" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0

  local lock port pid folder
  # A value the extension exported into this very terminal beats our guess, as long
  # as it still names a live editor: with the same project open in two windows it is
  # the only thing that knows which window the terminal belongs to.
  if [[ "${CLAUDE_CODE_SSE_PORT:-}" =~ ^[0-9]+$ ]]; then
    lock="$claude_ide_dir/$CLAUDE_CODE_SSE_PORT.lock"
    if [ -f "$lock" ]; then
      pid="$(jq -r '.pid // empty' "$lock" 2>/dev/null)" || pid=""
      if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        return 0
      fi
    fi
  fi

  while IFS= read -r lock; do
    [ -f "$lock" ] || continue
    port="${lock##*/}"
    port="${port%.lock}"
    [[ "$port" =~ ^[0-9]+$ ]] || continue
    pid="$(jq -r '.pid // empty' "$lock" 2>/dev/null)" || continue
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    kill -0 "$pid" 2>/dev/null || continue
    while IFS= read -r folder; do
      [ -n "$folder" ] || continue
      if [ "$PROJECT_DIR" = "$folder" ] || [ "${PROJECT_DIR#"$folder"/}" != "$PROJECT_DIR" ]; then
        printf '%s' "$port"
        return 0
      fi
    done < <(jq -r '.workspaceFolders[]? // empty' "$lock" 2>/dev/null)
  done < <(ls -1t "$claude_ide_dir"/*.lock 2>/dev/null)
}

IDE_ENV_ARGS=()
if ide_port="$(resolve_claude_ide_port)" && [ -n "$ide_port" ]; then
  IDE_ENV_ARGS+=(--setenv CLAUDE_CODE_SSE_PORT "$ide_port")
fi

# pi's IDE extensions have the same shape of problem, and there are two of them:
# npm:pi-x-ide keeps ~/.pi/pi-x-ide/lock/<ide>-<pid>-<port>.lock, npm:pi-ide-integration
# keeps ~/.pi/ide/<port>.lock. Each writes the editor's own pid into the lockfile and
# ignores any lockfile whose pid is not alive, so both go blind in the sandbox's PID
# namespace; pi-x-ide additionally rm's what it rejects, and ~/.pi is writable, so it
# wipes the host's lockfiles as well. Neither offers what claude's CLAUDE_CODE_SSE_PORT
# offers (pi-ide-integration's PI_IDE_PORT skips the liveness test but then hands over a
# connection with no auth token, because the token still comes from the rejected file).
#
# Both do accept a lockfile with no pid at all, which is the way in: pi-x-ide has pid
# optional in its schema and falls back to mtime freshness, and pi-ide-integration's own
# liveness helper answers true for an absent pid. So hand the sandbox a sanitized
# snapshot of each lock directory -- the lockfiles whose pid IS alive out here on the
# host, copied with the pid dropped -- bound read-only over the real thing. Rewriting
# the copies gives them a current mtime for free, and the bind keeps the originals out
# of the sandbox's reach at the same time. Dead lockfiles are left out rather than
# sanitized, so a stale one still looks stale from inside.
#
# ~/.claude/ide goes through the same pass, for the reason given where claude_ide_dir
# is resolved: it is read by more than just claude, and the readers that are not claude
# have no CLAUDE_CODE_SSE_PORT to fall back on. Dropping the pid costs claude nothing,
# because a host pid never passes its alive-and-an-ancestor test in here anyway.
snapshot_ide_lock_dir() {
  local lock_dir
  lock_dir="$(realpath -q "$1")" || return 0
  [ -d "$lock_dir" ] || return 0

  local snapshot lock pid name
  # Without jq there is nothing to sanitize with, and without a snapshot dir there is
  # nowhere to put the result. Fall back to binding the real directory read-only:
  # discovery is no better than before, but the host's lockfiles still survive the
  # sandboxed reaper and the agent still cannot plant one of its own.
  if ! command -v jq >/dev/null 2>&1; then
    IDE_RO_ARGS+=(--ro-bind "$lock_dir" "$lock_dir")
    return 0
  fi
  # $XDG_RUNTIME_DIR before /tmp: the sandbox replaces /tmp with a tmpfs, and a
  # snapshot the agent can neither see nor reach is one less thing to reason about.
  if ! snapshot="$(mktemp -d "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/agent-safe-ide.XXXXXX" 2>/dev/null)"; then
    IDE_RO_ARGS+=(--ro-bind "$lock_dir" "$lock_dir")
    return 0
  fi
  chmod 700 "$snapshot" 2>/dev/null || true

  for lock in "$lock_dir"/*.lock; do
    [ -f "$lock" ] || continue
    pid="$(jq -r '.pid // empty' "$lock" 2>/dev/null)" || continue
    if [[ "$pid" =~ ^[0-9]+$ ]] && ! kill -0 "$pid" 2>/dev/null; then
      continue
    fi
    name="${lock##*/}"
    if jq 'del(.pid)' "$lock" > "$snapshot/$name" 2>/dev/null; then
      chmod 600 "$snapshot/$name" 2>/dev/null || true
    else
      rm -f "$snapshot/$name"
    fi
  done

  # Bound even when it copied nothing: an empty snapshot says "no live editor", which
  # is the truth, and it still keeps the agent from planting a lockfile of its own in
  # a directory that a pi session on the host reads and connects to.
  IDE_LOCK_SNAPSHOTS+=("$snapshot")
  IDE_RO_ARGS+=(--ro-bind "$snapshot" "$lock_dir")
}

for ide_lock_dir in "$HOME/.pi/pi-x-ide/lock" "$HOME/.pi/ide" "$claude_ide_dir"; do
  [ -n "$ide_lock_dir" ] || continue
  snapshot_ide_lock_dir "$ide_lock_dir"
done
if [ "${#IDE_LOCK_SNAPSHOTS[@]}" -gt 0 ]; then
  trap cleanup EXIT INT TERM
fi

# No bind is needed for $SSH_AUTH_SOCK: connecting to a unix socket works
# through the read-only bind of /, so a forwarded agent is already reachable.

BWRAP_ARGS=(
  --ro-bind / /
  --dev /dev
  --tmpfs /dev/shm
  --tmpfs /tmp
  # A PID namespace keeps the agent's process management inside the sandbox: a
  # stray `pkill -f node` or `killall java` can no longer reach your editor,
  # your daemons, or another agent session. --proc is required to go with it,
  # or /proc would still show the host's processes.
  --proc /proc
  --unshare-pid
  # Tear the sandbox down with the launching shell, so build daemons started
  # inside it (gradle, pnpm, node watchers) do not outlive the session.
  --die-with-parent
)

# Default cache binds and project dir go after --tmpfs /tmp, which would otherwise
# silently shadow any bind resolving under /tmp, and before masks so default
# binds (like project dir when in $HOME) do not re-expose secrets or sockets.
# User-provided write mounts (-w / --write and AGENT_SAFE_WRITE) are applied after
# all masks and protections below, so user requests have the last say.
BWRAP_ARGS+=(
  "${BIND_ARGS[@]}"
  --bind "$PROJECT_DIR" "$PROJECT_DIR"
  "${GIT_PIN_ARGS[@]}"
  "${GIT_RO_ARGS[@]}"
  "${IDE_RO_ARGS[@]}"
)

if [[ -d /etc/ssh/ssh_config.d ]]; then
  BWRAP_ARGS+=(--tmpfs /etc/ssh/ssh_config.d)
fi

# Isolate Gradle daemon state on tmpfs so sandboxed builds do not connect to or
# hijack daemons running on the host.
if [[ -d "$HOME/.gradle" ]]; then
  mkdir -p "$HOME/.gradle/daemon" 2>/dev/null || true
  BWRAP_ARGS+=(--tmpfs "$HOME/.gradle/daemon")
fi

masked_socks=()

mask_socket() {
  local target="$1"
  local real_target
  real_target="$(realpath -q "$target" 2>/dev/null)" || return 0
  [[ -S "$real_target" || -e "$real_target" ]] || return 0

  local p
  for p in ${masked_socks[@]+"${masked_socks[@]}"}; do
    if [[ "$real_target" == "$p" || "$real_target" == "$p"/* ]]; then
      return 0
    fi
  done

  # Build path components from root to target to verify all ancestor directories
  # are readable by the current user. If an ancestor directory cannot be read
  # (e.g. /run/containerd with mode 0711), bwrap's openat2() fails with EACCES
  # when resolving parent mountpoints. In that case, mask the topmost
  # unreadable directory with tmpfs instead of binding /dev/null to the socket.
  local cur="$real_target"
  local components=()
  while [[ "$cur" != "/" && "$cur" != "." ]]; do
    components=("$cur" "${components[@]}")
    cur="$(dirname "$cur")"
  done

  local unreadable_dir=""
  local c
  for c in "${components[@]}"; do
    if [[ "$c" == "$real_target" ]]; then
      break
    fi
    if [[ ! -r "$c" ]]; then
      unreadable_dir="$c"
      break
    fi
  done

  if [[ -n "$unreadable_dir" ]]; then
    masked_socks+=("$unreadable_dir")
    BWRAP_ARGS+=(--tmpfs "$unreadable_dir")
  else
    masked_socks+=("$real_target")
    BWRAP_ARGS+=(--ro-bind /dev/null "$real_target")
  fi
}

# Container engine sockets allow an agent to control a host daemon (usually running
# as root or with host user access), mount host filesystems read-write, and bypass
# the sandbox completely. Mask them with /dev/null (or tmpfs) and strip environment pointers.
if [[ "${AGENT_SAFE_ALLOW_DOCKER:-0}" != "1" ]]; then
  CONTAINER_SOCKS=(
    "/run/docker.sock"
    "/var/run/docker.sock"
    "${XDG_RUNTIME_DIR:-/run/user/${UID:-$(id -u)}}/docker.sock"
    "/run/podman/podman.sock"
    "/var/run/podman/podman.sock"
    "${XDG_RUNTIME_DIR:-/run/user/${UID:-$(id -u)}}/podman/podman.sock"
    "/run/containerd/containerd.sock"
    "/run/k3s/containerd/containerd.sock"
  )
  if [[ -n "${DOCKER_HOST:-}" && "$DOCKER_HOST" =~ ^unix:// ]]; then
    CONTAINER_SOCKS+=("${DOCKER_HOST#unix://}")
  fi
  if [[ -n "${CONTAINER_HOST:-}" && "$CONTAINER_HOST" =~ ^unix:// ]]; then
    CONTAINER_SOCKS+=("${CONTAINER_HOST#unix://}")
  fi

  for sock in "${CONTAINER_SOCKS[@]}"; do
    mask_socket "$sock"
  done

  BWRAP_ARGS+=(
    --unsetenv DOCKER_HOST
    --unsetenv CONTAINER_HOST
  )
fi

# D-Bus, systemd private IPC, and audio daemon sockets allow an agent to escape
# the sandbox by spawning host units via `systemd-run --user` (or org.freedesktop.systemd1),
# access desktop secret services, or record host microphone audio.
HOST_IPC_SOCKS=(
  "${XDG_RUNTIME_DIR:-/run/user/${UID:-$(id -u)}}/bus"
  "${XDG_RUNTIME_DIR:-/run/user/${UID:-$(id -u)}}/systemd/private"
  "/run/systemd/private"
  "/run/dbus/system_bus_socket"
  "${XDG_RUNTIME_DIR:-/run/user/${UID:-$(id -u)}}/pipewire-0"
  "${XDG_RUNTIME_DIR:-/run/user/${UID:-$(id -u)}}/pulse/native"
)
for sock in "${HOST_IPC_SOCKS[@]}"; do
  mask_socket "$sock"
done

BWRAP_ARGS+=(
  --unsetenv DBUS_SESSION_BUS_ADDRESS
  --unsetenv DBUS_SYSTEM_BUS_ADDRESS
)

# Mask sensitive host credentials from read access
if [[ "$MASK_SECRETS" -eq 1 ]]; then
  SECRET_PATHS=(
    "$HOME/.ssh"
    "$HOME/.aws"
    "$HOME/.gnupg"
    "$HOME/.kube"
    "$HOME/.docker"
    "${XDG_RUNTIME_DIR:-/run/user/${UID:-$(id -u)}}/gnupg"
    "${XDG_RUNTIME_DIR:-/run/user/${UID:-$(id -u)}}/keyring"
  )
  for secret in "${SECRET_PATHS[@]}"; do
    if [[ -e "$secret" ]]; then
      BWRAP_ARGS+=(--tmpfs "$secret")
    fi
  done

  # Preserve known hosts, config, and public keys so git SSH and ssh-agent identity selection work
  if [[ -f "$HOME/.ssh/known_hosts" ]]; then
    BWRAP_ARGS+=(--ro-bind "$HOME/.ssh/known_hosts" "$HOME/.ssh/known_hosts")
  fi
  if [[ -f "$HOME/.ssh/config" ]]; then
    BWRAP_ARGS+=(--ro-bind "$HOME/.ssh/config" "$HOME/.ssh/config")
  fi
  if [[ -d "$HOME/.ssh/config.d" ]]; then
    BWRAP_ARGS+=(--ro-bind "$HOME/.ssh/config.d" "$HOME/.ssh/config.d")
  fi
  for pubkey in "$HOME/.ssh"/*.pub; do
    if [[ -f "$pubkey" ]]; then
      BWRAP_ARGS+=(--ro-bind "$pubkey" "$pubkey")
    fi
  done
fi

# Network isolation
if [[ "$OFFLINE" -eq 1 ]]; then
  BWRAP_ARGS+=(--unshare-net)
fi

# User-provided extra write mounts (-w / --write and AGENT_SAFE_WRITE) have the
# last say, applied after all masks and protections.
if [[ ${#USER_WRITE_ARGS[@]} -gt 0 ]]; then
  BWRAP_ARGS+=("${USER_WRITE_ARGS[@]}")
fi

BWRAP_ARGS+=(
  --chdir "$PROJECT_DIR"
  --setenv PS1 "sandbox$ "
  --setenv AGENT_SAFE 1
  "${IDE_ENV_ARGS[@]}"
)

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "agent-safe [dry-run]:"
  echo "  Target: $TARGET"
  echo "  Project directory: $PROJECT_DIR"
  echo "  Command: ${RUN_CMD[*]}"
  echo "  Bubblewrap arguments:"
  printf '    %q\n' "${BWRAP_ARGS[@]}" "${RUN_CMD[@]}"
  exit 0
fi

# Only a nested run or AGENT_SAFE_ALLOW_UNSANDBOXED=1 gets here; the rest were
# refused up top.
if [[ "$SANDBOX_OK" -eq 0 ]]; then
  local_target="$TARGET"
  [[ "$local_target" == "raw" ]] && local_target="command"
  if [[ "${AGENT_SAFE:-0}" == "1" ]]; then
    echo "agent-safe: already inside sandbox; running $local_target directly in $PROJECT_DIR" >&2
  else
    echo "agent-safe: sandbox unavailable; AGENT_SAFE_ALLOW_UNSANDBOXED=1, running $local_target UNSANDBOXED in $PROJECT_DIR" >&2
  fi
  cd "$PROJECT_DIR"
  "${RUN_CMD[@]}"
  exit $?
fi

if [[ "$TARGET" == "pi-web" ]]; then
  echo "agent-safe [pi-web]: sandboxed, writable project: $PROJECT_DIR"
  echo "agent-safe [pi-web]: ~/.pi and build tool caches writable, /tmp tmpfs, everything else read-only"
  echo "agent-safe [pi-web]: pick $PROJECT_DIR as the session cwd in the pi-web UI"
else
  echo "Entering sandbox for $PROJECT_DIR ($TARGET mode)"
fi

bwrap "${BWRAP_ARGS[@]}" "${RUN_CMD[@]}"
