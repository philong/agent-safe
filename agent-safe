#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF' >&2
usage: agent-safe [options] <target|command> [args...]
       agent-safe [project-dir]           (when invoked as pi-web-safe)

Options must come BEFORE the target; everything after it is passed
through to the target untouched (so `agent-safe claude --help` shows
Claude's help, not this one).

Runs AI coding agents in a bubblewrap sandbox where the project directory,
agent configs, and a narrow set of build tool caches are writable; everything
else read-only.

Targets / Modes:
  pi               Run Pi CLI in yolo mode
  pi-web           Run Pi Web in yolo mode (pnpx @agegr/pi-web@latest --hostname 0.0.0.0)
  agy              Run Antigravity CLI (agy --dangerously-skip-permissions)
  claude           Run Claude Code CLI (claude --dangerously-skip-permissions)
  codex            Run Codex CLI (codex --dangerously-bypass-approvals-and-sandbox)
  copilot          Run GitHub Copilot CLI (copilot --yolo)
  aider            Run Aider (aider --yes)
  shell [args...]  Run an interactive shell inside the sandbox
  run <cmd...>     Run an arbitrary command inside the sandbox

Multi-call symlink shortcuts:
  pi-safe          -> runs 'pi' mode directly
  pi-web-safe      -> runs 'pi-web' mode directly
  agy-safe         -> runs 'agy' mode directly
  claude-safe      -> runs 'claude' mode directly
  codex-safe       -> runs 'codex' mode directly
  copilot-safe     -> runs 'copilot' mode directly
  aider-safe       -> runs 'aider' mode directly

Options:
  -C, --cwd <dir>    Set project working directory (default: current directory)
  -w, --write <dir>  Mount an extra directory as writable inside sandbox
  --offline, --no-net Run with network isolation (disable network access)
  --dry-run          Print sandbox configuration and bwrap command without executing
  --no-mask          Do not mask host secrets (~/.ssh, ~/.aws, etc.)
  -h, --help         Show this help message
EOF
  exit 1
}

PROG="$(basename "$0")"
TARGET=""

case "$PROG" in
  *pi-web*|*web*) TARGET="pi-web" ;;
  *copilot*) TARGET="copilot" ;;
  *pi*)      TARGET="pi" ;;
  *agy*)     TARGET="agy" ;;
  *claude*)  TARGET="claude" ;;
  *codex*)   TARGET="codex" ;;
  *aider*)   TARGET="aider" ;;
  *shell*|*bash*|*sh*) TARGET="shell" ;;
  *)         TARGET="" ;;
esac

MASK_SECRETS=1
if [[ "${AGENT_SAFE_NO_MASK:-0}" == "1" ]]; then
  MASK_SECRETS=0
fi

OFFLINE=0
if [[ "${AGENT_SAFE_OFFLINE:-0}" == "1" ]]; then
  OFFLINE=1
fi

PROJECT_DIR="$PWD"
EXTRA_WRITE_CLI=()
DRY_RUN=0

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      ;;
    --offline|--no-net)
      OFFLINE=1
      shift
      ;;
    --dry-run|--info)
      DRY_RUN=1
      shift
      ;;
    -C|--cwd|--dir)
      [[ $# -ge 2 ]] || { echo "agent-safe: $1 requires a directory argument" >&2; exit 1; }
      PROJECT_DIR="$2"
      shift 2
      ;;
    -w|--write|--bind)
      [[ $# -ge 2 ]] || { echo "agent-safe: $1 requires a directory argument" >&2; exit 1; }
      EXTRA_WRITE_CLI+=("$2")
      shift 2
      ;;
    --no-mask)
      MASK_SECRETS=0
      shift
      ;;
    --pi|pi)
      TARGET="pi"
      shift
      break
      ;;
    --pi-web|pi-web|--web|web)
      TARGET="pi-web"
      shift
      break
      ;;
    --agy|agy)
      TARGET="agy"
      shift
      break
      ;;
    --claude|claude)
      TARGET="claude"
      shift
      break
      ;;
    --codex|codex)
      TARGET="codex"
      shift
      break
      ;;
    --copilot|copilot)
      TARGET="copilot"
      shift
      break
      ;;
    --aider|aider)
      TARGET="aider"
      shift
      break
      ;;
    shell|bash|sh)
      TARGET="shell"
      shift
      break
      ;;
    run|--)
      TARGET="raw"
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if [[ -z "$TARGET" ]]; then
  usage
fi

# In pi-web mode, first positional non-flag argument can be project directory
if [[ "$TARGET" == "pi-web" && $# -gt 0 && "$1" != -* ]]; then
  PROJECT_DIR="$1"
  shift
fi
# Resolve into a temporary, or the failed assignment would blank $PROJECT_DIR
# before the error message gets to name it.
if ! project_dir_real="$(realpath -e -- "$PROJECT_DIR" 2>/dev/null)"; then
  echo "agent-safe: cannot resolve project dir: $PROJECT_DIR" >&2
  exit 1
fi
PROJECT_DIR="$project_dir_real"

can_sandbox() {
  command -v bwrap >/dev/null 2>&1 && bwrap --ro-bind / / true >/dev/null 2>&1
}
: "${HOME:?agent-safe: HOME is not set}"

EXTRA_DIRS=()
RUN_CMD=()
ENABLE_PI_YOLO=false

case "$TARGET" in
  pi)
    command -v pi >/dev/null 2>&1 || { echo "agent-safe: 'pi' not found in PATH" >&2; exit 1; }
    ENABLE_PI_YOLO=true
    RUN_CMD=(pi --approve "$@")
    ;;
  pi-web)
    command -v pnpx >/dev/null 2>&1 || { echo "agent-safe: 'pnpx' not found in PATH" >&2; exit 1; }
    ENABLE_PI_YOLO=true
    # pi-web is fetched and run by pnpx on every start, so unlike other modes
    # this sandbox must let pnpm write its store, installed packages and state.
    EXTRA_DIRS+=(
      "${XDG_CACHE_HOME:-$HOME/.cache}/pnpm"
      "${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
      "${XDG_STATE_HOME:-$HOME/.local/state}/pnpm"
    )
    if [[ -n "${PNPM_HOME:-}" ]]; then
      EXTRA_DIRS+=("$PNPM_HOME")
    fi
    RUN_CMD=(pnpx "@agegr/pi-web@latest" --hostname 0.0.0.0 "$@")
    ;;
  agy)
    command -v agy >/dev/null 2>&1 || { echo "agent-safe: 'agy' not found in PATH" >&2; exit 1; }
    RUN_CMD=(agy --dangerously-skip-permissions "$@")
    ;;
  claude)
    command -v claude >/dev/null 2>&1 || { echo "agent-safe: 'claude' not found in PATH" >&2; exit 1; }
    RUN_CMD=(claude --dangerously-skip-permissions "$@")
    ;;
  codex)
    command -v codex >/dev/null 2>&1 || { echo "agent-safe: 'codex' not found in PATH" >&2; exit 1; }
    RUN_CMD=(codex --dangerously-bypass-approvals-and-sandbox "$@")
    ;;
  copilot)
    command -v copilot >/dev/null 2>&1 || { echo "agent-safe: 'copilot' not found in PATH" >&2; exit 1; }
    RUN_CMD=(copilot --yolo "$@")
    ;;
  aider)
    command -v aider >/dev/null 2>&1 || { echo "agent-safe: 'aider' not found in PATH" >&2; exit 1; }
    RUN_CMD=(aider --yes "$@")
    ;;
  shell)
    user_shell="${SHELL:-/bin/bash}"
    if [[ $# -gt 0 ]]; then
      RUN_CMD=("$user_shell" "$@")
    else
      RUN_CMD=("$user_shell" "-i")
    fi
    ;;
  raw)
    if [[ $# -eq 0 ]]; then
      echo "agent-safe run: no command specified" >&2
      exit 1
    fi
    RUN_CMD=("$@")
    ;;
esac

case "$TARGET" in
  pi|pi-web) mkdir -p "$HOME/.pi" 2>/dev/null || true ;;
  agy)       mkdir -p "$HOME/.gemini" 2>/dev/null || true ;;
  claude)    mkdir -p "$HOME/.claude" 2>/dev/null || true ;;
  codex)     mkdir -p "$HOME/.codex" 2>/dev/null || true ;;
  copilot)   mkdir -p "$HOME/.copilot" 2>/dev/null || true ;;
  aider)     mkdir -p "$HOME/.aider" 2>/dev/null || true ;;
esac
PI_DIR="$(realpath ~/.pi 2>/dev/null || echo "$HOME/.pi")"
PERM_CONFIG="$PI_DIR/agent/extensions/pi-permission-system/config.json"

set_yolo_mode() {
  local mode="$1"
  if [[ -f "$PERM_CONFIG" ]] && command -v jq >/dev/null 2>&1; then
    local tmp_file
    tmp_file="$(mktemp "${PERM_CONFIG}.tmp.XXXXXX" 2>/dev/null || mktemp)" || return 1
    if jq --argjson val "$mode" '.yoloMode = $val' "$PERM_CONFIG" > "$tmp_file" 2>/dev/null; then
      mv "$tmp_file" "$PERM_CONFIG"
    else
      rm -f "$tmp_file"
    fi
  fi
}

# yoloMode is global state in a shared config file, so concurrent pi sessions have
# to be reference counted: without this the first session to exit turns yoloMode
# off underneath every session still running. One marker file per live session,
# named by pid so a session killed with -9 can be reaped by the next one.
YOLO_RUN_DIR="$PI_DIR/.agent-safe-yolo"
YOLO_MARKER=""

yolo_live_sessions() {
  local marker pid count=0
  for marker in "$YOLO_RUN_DIR"/*; do
    [ -f "$marker" ] || continue
    pid="${marker##*/}"
    # Anything not named after a pid is bookkeeping (the "prior" file), not a session.
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$marker"
      continue
    fi
    count=$((count + 1))
  done
  echo "$count"
}

cleanup() {
  trap - EXIT INT TERM
  [ -n "$YOLO_MARKER" ] || return 0
  rm -f "$YOLO_MARKER"
  YOLO_MARKER=""
  # Restore only once the last session is gone, and only to what we found.
  if [ "$(yolo_live_sessions)" -eq 0 ] && [ -f "$YOLO_RUN_DIR/prior" ]; then
    set_yolo_mode "$(cat "$YOLO_RUN_DIR/prior")"
    rm -f "$YOLO_RUN_DIR/prior"
  fi
}

if [[ "$ENABLE_PI_YOLO" == true ]]; then
  if mkdir -p "$YOLO_RUN_DIR" 2>/dev/null; then
    # Snapshot only when no record survives. A leftover "prior" with no live
    # session means an earlier run was killed before it could restore; that file
    # still holds the untouched value, while the config now holds ours.
    if [ ! -f "$YOLO_RUN_DIR/prior" ]; then
      # Remember whether the user already had yoloMode on, so we hand it back
      # instead of hardcoding false.
      prior=false
      if [[ -f "$PERM_CONFIG" ]] && command -v jq >/dev/null 2>&1; then
        prior="$(jq -r 'if .yoloMode == true then "true" else "false" end' "$PERM_CONFIG" 2>/dev/null || echo false)"
      fi
      printf '%s' "$prior" > "$YOLO_RUN_DIR/prior" 2>/dev/null || true
    fi
    YOLO_MARKER="$YOLO_RUN_DIR/$$"
    : > "$YOLO_MARKER" 2>/dev/null || YOLO_MARKER=""
  fi
  trap cleanup EXIT INT TERM
  set_yolo_mode true
fi

# Writable paths for build tooling and agent configs.
#
# These are deliberately narrow: only directories holding downloaded artifacts
# and compiled output, never a tool's root directory. Roots such as ~/.cargo,
# ~/.local/share or ~/.nvm hold executables that are on your PATH, and config
# that runs on the next build (~/.cargo/config.toml, ~/.gradle/init.d,
# ~/.m2/settings.xml). Making those writable would let the agent plant code
# that later runs OUTSIDE the sandbox, which defeats the point of agent-safe.
CACHE_DIRS=(
  # Agent config: extensions, settings, auth, session history
  "$HOME/.pi"
  "$HOME/.gemini"
  "$HOME/.claude"
  "$HOME/.claude.json"
  "$HOME/.config/claude"
  "$HOME/.codex"
  "$HOME/.config/codex"
  "$HOME/.copilot"
  "$HOME/.config/copilot"
  "$HOME/.config/github-copilot"
  "$HOME/.aider"
  "$HOME/.aider.conf.yml"
  "$HOME/.aider.chat.history.md"

  # JVM
  "$HOME/.m2/repository"
  "$HOME/.gradle/caches"
  "$HOME/.gradle/wrapper"
  "$HOME/.gradle/native"
  "$HOME/.gradle/daemon"
  "$HOME/.gradle/workers"
  "$HOME/.ivy2/cache"
  "$HOME/.cache/coursier"

  # Rust
  "$HOME/.cargo/registry"
  "$HOME/.cargo/git"

  # Go
  "$HOME/go/pkg/mod"
  "$HOME/.cache/go-build"

  # Node
  "$HOME/.npm/_cacache"
  "$HOME/.pnpm-store"
  "$HOME/.cache/yarn"
  "$HOME/.yarn/berry/cache"
  "$HOME/.bun/install/cache"
  "$HOME/.cache/deno"
  "$HOME/.cache/node-gyp"
  "$HOME/.cache/ms-playwright"

  # Python
  "$HOME/.cache/pip"
  "$HOME/.cache/uv"
  "$HOME/.cache/pypoetry"

  # .NET, PHP, Dart, Ruby, Haskell, Elixir
  "$HOME/.nuget/packages"
  "$HOME/.cache/composer"
  "$HOME/.pub-cache/hosted"
  "$HOME/.pub-cache/git"
  "$HOME/.gem/cache"
  "$HOME/.cabal/packages"
  "$HOME/.stack/pantry"
  "$HOME/.hex/packages"

  # Compiler caches (C/C++/Rust object caches, keyed by content hash)
  "${CCACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/ccache}"
  "$HOME/.ccache"
  "$HOME/.cache/sccache"

  # Version manager download caches (not the installed toolchains)
  "$HOME/.cache/mise"
)

# Left read-only on purpose:
#   ~/.local/share       .desktop files, systemd user units, mise/pipx installs
#   ~/.cache/pre-commit  hook environments, executed by git outside the sandbox
#   ~/.nvm ~/.pyenv ~/.asdf ~/.sdkman ~/.rustup ~/.cargo/bin ~/.bun/bin
#                        interpreters and shims that are on your PATH
# Installing a toolchain or a global CLI therefore has to happen outside agent-safe.

# Append extra directory binds from specific modes (e.g. pnpm dirs for pi-web mode)
if [[ ${#EXTRA_DIRS[@]} -gt 0 ]]; then
  for p_dir in "${EXTRA_DIRS[@]}"; do
    mkdir -p "$p_dir" 2>/dev/null || true
  done
  CACHE_DIRS+=("${EXTRA_DIRS[@]}")
fi

# Append extra directory binds from CLI flags (-w / --write)
if [[ ${#EXTRA_WRITE_CLI[@]} -gt 0 ]]; then
  CACHE_DIRS+=("${EXTRA_WRITE_CLI[@]}")
fi

# Escape hatch: AGENT_SAFE_WRITE=/path/one:/path/two agent-safe
EXTRA_WRITE="${AGENT_SAFE_WRITE:-}"
if [ -n "$EXTRA_WRITE" ]; then
  IFS=':' read -r -a extra_write_dirs <<<"$EXTRA_WRITE"
  CACHE_DIRS+=("${extra_write_dirs[@]}")
fi

BIND_ARGS=()
bound=""

add_bind() {
  local path="$1" mode="${2:---bind}" real
  real="$(realpath -q "$path")" || return 0
  [ -e "$real" ] || return 0
  case ":$bound:" in *":$mode $real:"*) return 0 ;; esac
  bound="$bound:$mode $real"
  BIND_ARGS+=("$mode" "$real" "$real")
}

for dir in "${CACHE_DIRS[@]}"; do
  # Create a cache dir only when its tool is already installed, i.e. when the
  # parent exists, so agent-safe never litters $HOME for tools you do not use.
  parent="$(dirname "$dir")"
  if [ ! -e "$dir" ] && [ "$parent" != "$HOME" ] && [ "$parent" != "$HOME/.config" ] && [ -d "$parent" ]; then
    mkdir -p "$dir" 2>/dev/null || true
  fi
  add_bind "$dir"
done

# Git hooks are executed by git ON THE HOST the next time you run a git command in
# this repo, so keep hooks/ read-only in every repo layout. Nothing legitimately
# writes it, and an agent that drops a script there escapes the sandbox by accident.
# .git/config stays writable: `git config` and `git remote add` are normal things to
# run, and a bad value there is local and easy to undo.
# For worktrees and repo subdirectories the real .git is outside $PROJECT_DIR and
# also has to be bound writable, or git refuses to commit.
GIT_RO_ARGS=()
if git_common="$(git -C "$PROJECT_DIR" rev-parse --git-common-dir 2>/dev/null)"; then
  git_common="$(cd "$PROJECT_DIR" && realpath -q "$git_common")" || git_common=""
  if [ -n "$git_common" ]; then
    mkdir -p "$git_common/hooks" 2>/dev/null || true
    if [ "${git_common#"$PROJECT_DIR"/}" = "$git_common" ]; then
      add_bind "$git_common"
    fi
    # Applied after the $PROJECT_DIR bind below, which would otherwise re-expose
    # hooks/ as writable.
    git_hooks="$(realpath -q "$git_common/hooks")" || git_hooks=""
    if [ -n "$git_hooks" ] && [ -e "$git_hooks" ]; then
      GIT_RO_ARGS+=(--ro-bind "$git_hooks" "$git_hooks")
    fi
  fi
fi

# No bind is needed for $SSH_AUTH_SOCK: connecting to a unix socket works
# through the read-only bind of /, so a forwarded agent is already reachable.

BWRAP_ARGS=(
  --ro-bind / /
  --dev /dev
  --tmpfs /dev/shm
  --tmpfs /tmp
  # A PID namespace keeps the agent's process management inside the sandbox: a
  # stray `pkill -f node` or `killall java` can no longer reach your editor,
  # your daemons, or another agent session. --proc is required to go with it,
  # or /proc would still show the host's processes.
  --proc /proc
  --unshare-pid
  # Tear the sandbox down with the launching shell, so build daemons started
  # inside it (gradle, pnpm, node watchers) do not outlive the session.
  --die-with-parent
)

if [[ -d /etc/ssh/ssh_config.d ]]; then
  BWRAP_ARGS+=(--tmpfs /etc/ssh/ssh_config.d)
fi

# Mask sensitive host credentials from read access
if [[ "$MASK_SECRETS" -eq 1 ]]; then
  SECRET_PATHS=(
    "$HOME/.ssh"
    "$HOME/.aws"
    "$HOME/.gnupg"
    "$HOME/.kube"
    "$HOME/.docker"
  )
  for secret in "${SECRET_PATHS[@]}"; do
    if [[ -e "$secret" ]]; then
      BWRAP_ARGS+=(--tmpfs "$secret")
    fi
  done

  # Preserve known hosts, config, and public keys so git SSH and ssh-agent identity selection work
  if [[ -f "$HOME/.ssh/known_hosts" ]]; then
    BWRAP_ARGS+=(--ro-bind "$HOME/.ssh/known_hosts" "$HOME/.ssh/known_hosts")
  fi
  if [[ -f "$HOME/.ssh/config" ]]; then
    BWRAP_ARGS+=(--ro-bind "$HOME/.ssh/config" "$HOME/.ssh/config")
  fi
  if [[ -d "$HOME/.ssh/config.d" ]]; then
    BWRAP_ARGS+=(--ro-bind "$HOME/.ssh/config.d" "$HOME/.ssh/config.d")
  fi
  for pubkey in "$HOME/.ssh"/*.pub; do
    if [[ -f "$pubkey" ]]; then
      BWRAP_ARGS+=(--ro-bind "$pubkey" "$pubkey")
    fi
  done
fi

# Network isolation
if [[ "$OFFLINE" -eq 1 ]]; then
  BWRAP_ARGS+=(--unshare-net)
fi

# Binds go after --tmpfs /tmp, which would otherwise silently shadow any bind
# resolving under /tmp.
BWRAP_ARGS+=(
  "${BIND_ARGS[@]}"
  --bind "$PROJECT_DIR" "$PROJECT_DIR"
  "${GIT_RO_ARGS[@]}"
  --chdir "$PROJECT_DIR"
  --setenv PS1 "sandbox$ "
)

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "agent-safe [dry-run]:"
  echo "  Target: $TARGET"
  echo "  Project directory: $PROJECT_DIR"
  echo "  Command: ${RUN_CMD[*]}"
  echo "  Bubblewrap arguments:"
  printf '    %q\n' "${BWRAP_ARGS[@]}" "${RUN_CMD[@]}"
  exit 0
fi

if ! can_sandbox; then
  local_target="$TARGET"
  [[ "$local_target" == "raw" ]] && local_target="command"
  echo "agent-safe: sandbox unavailable (already in container/sandbox or unprivileged userns disabled)" >&2
  echo "agent-safe: running $local_target directly in $PROJECT_DIR" >&2
  cd "$PROJECT_DIR"
  "${RUN_CMD[@]}"
  exit $?
fi

if [[ "$TARGET" == "pi-web" ]]; then
  echo "agent-safe [pi-web]: sandboxed, writable project: $PROJECT_DIR"
  echo "agent-safe [pi-web]: ~/.pi and build tool caches writable, /tmp tmpfs, everything else read-only"
  echo "agent-safe [pi-web]: pick $PROJECT_DIR as the session cwd in the pi-web UI"
else
  echo "Entering sandbox for $PROJECT_DIR ($TARGET mode)"
fi

bwrap "${BWRAP_ARGS[@]}" "${RUN_CMD[@]}"
