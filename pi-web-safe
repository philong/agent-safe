#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: pi-web-safe [project-dir] [pi-web args...]" >&2
  echo "  Runs pi-web (pnpx @agegr/pi-web@latest --hostname 0.0.0.0) in a bubblewrap" >&2
  echo "  sandbox where the project directory, ~/.pi, ~/.gemini and a narrow set of" >&2
  echo "  build tool caches are writable; everything else read-only. Defaults to the" >&2
  echo "  current directory if [project-dir] is omitted." >&2
  echo "  Enables pi-permission-system yolo mode for the run; restored on exit." >&2
  echo "  Remember to pick the project dir as the session cwd in the pi-web UI." >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  usage
fi

# First non-flag argument is the project dir; default to current directory
PROJECT_DIR="$PWD"
if [[ $# -gt 0 && "$1" != -* ]]; then
  PROJECT_DIR="$1"
  shift
fi
PROJECT_DIR="$(realpath -e -- "$PROJECT_DIR")" || { echo "pi-web-safe: cannot resolve project dir: $PROJECT_DIR" >&2; exit 1; }

command -v pnpx >/dev/null 2>&1 || { echo "pi-web-safe: 'pnpx' not found in PATH" >&2; exit 1; }
command -v bwrap >/dev/null 2>&1 || { echo "pi-web-safe: 'bwrap' not found in PATH" >&2; exit 1; }
: "${HOME:?pi-web-safe: HOME is not set}"

mkdir -p ~/.pi ~/.gemini 2>/dev/null || true
PI_DIR="$(realpath ~/.pi)" || { echo "pi-web-safe: cannot resolve ~/.pi" >&2; exit 1; }

# --- yolo mode handling (ported from pi-safe) ---
PERM_CONFIG="$PI_DIR/agent/extensions/pi-permission-system/config.json"

set_yolo_mode() {
  local mode="$1"
  if [[ -f "$PERM_CONFIG" ]] && command -v jq >/dev/null 2>&1; then
    local tmp_file
    tmp_file="$(mktemp "${PERM_CONFIG}.tmp.XXXXXX" 2>/dev/null || mktemp)" || return 1
    if jq --argjson val "$mode" '.yoloMode = $val' "$PERM_CONFIG" > "$tmp_file" 2>/dev/null; then
      mv "$tmp_file" "$PERM_CONFIG"
    else
      rm -f "$tmp_file"
    fi
  fi
}

PREV_YOLO="false"
if [[ -f "$PERM_CONFIG" ]] && command -v jq >/dev/null 2>&1; then
  PREV_YOLO="$(jq -r '.yoloMode // false' "$PERM_CONFIG" 2>/dev/null || echo false)"
fi

cleanup() {
  trap - EXIT INT TERM
  set_yolo_mode "$PREV_YOLO"
}
trap cleanup EXIT INT TERM

set_yolo_mode true
[[ "$PREV_YOLO" == "true" ]] || echo "pi-web-safe: yolo mode enabled (was: $PREV_YOLO), will restore on exit"
# --- end yolo mode handling ---

# Writable paths for build tooling. Kept in sync with pi-safe; the two scripts
# are installed one file at a time, so the list is duplicated rather than shared.
#
# These are deliberately narrow: only directories holding downloaded artifacts
# and compiled output, never a tool's root directory. Roots such as ~/.cargo,
# ~/.local/share or ~/.nvm hold executables that are on your PATH, and config
# that runs on the next build (~/.cargo/config.toml, ~/.gradle/init.d,
# ~/.m2/settings.xml). Making those writable would let the agent plant code
# that later runs OUTSIDE the sandbox, which defeats the point of pi-web-safe.
CACHE_DIRS=(
  # Agent config: extensions, AGENTS.md
  "$HOME/.pi"
  "$HOME/.gemini"

  # JVM
  "$HOME/.m2/repository"
  "$HOME/.gradle/caches"
  "$HOME/.gradle/wrapper"
  "$HOME/.gradle/native"
  "$HOME/.gradle/daemon"
  "$HOME/.gradle/workers"
  "$HOME/.ivy2/cache"
  "$HOME/.cache/coursier"

  # Rust
  "$HOME/.cargo/registry"
  "$HOME/.cargo/git"

  # Go
  "$HOME/go/pkg/mod"
  "$HOME/.cache/go-build"

  # Node
  "$HOME/.npm/_cacache"
  "$HOME/.pnpm-store"
  "$HOME/.cache/yarn"
  "$HOME/.yarn/berry/cache"
  "$HOME/.bun/install/cache"
  "$HOME/.cache/deno"
  "$HOME/.cache/node-gyp"
  "$HOME/.cache/ms-playwright"

  # Python
  "$HOME/.cache/pip"
  "$HOME/.cache/uv"
  "$HOME/.cache/pypoetry"

  # .NET, PHP, Dart, Ruby, Haskell, Elixir
  "$HOME/.nuget/packages"
  "$HOME/.cache/composer"
  "$HOME/.pub-cache/hosted"
  "$HOME/.pub-cache/git"
  "$HOME/.gem/cache"
  "$HOME/.cabal/packages"
  "$HOME/.stack/pantry"
  "$HOME/.hex/packages"

  # Version manager download caches (not the installed toolchains)
  "$HOME/.cache/mise"
)

# Left read-only on purpose:
#   ~/.cache/pre-commit  hook environments, executed by git outside the sandbox
#   ~/.nvm ~/.pyenv ~/.asdf ~/.sdkman ~/.rustup ~/.cargo/bin ~/.bun/bin
#                        interpreters and shims that are on your PATH
# Installing a toolchain or a global CLI therefore has to happen outside
# pi-web-safe.

# Escape hatch, same variable as pi-safe: PI_SAFE_WRITE=/path/one:/path/two
if [ -n "${PI_SAFE_WRITE:-}" ]; then
  IFS=':' read -r -a extra_dirs <<<"$PI_SAFE_WRITE"
  CACHE_DIRS+=("${extra_dirs[@]}")
fi

# pi-web is fetched and run by pnpx on every start, so unlike pi-safe this
# sandbox must let pnpm write its store, its installed packages and its state.
# That includes ~/.local/share/pnpm, which pi-safe keeps read-only: the CLI
# shims pnpm puts there are on your PATH outside the sandbox.
PNPM_DIRS=(
  "${XDG_CACHE_HOME:-$HOME/.cache}/pnpm"
  "${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
  "${XDG_STATE_HOME:-$HOME/.local/state}/pnpm"
)
if [[ -n "${PNPM_HOME:-}" ]]; then
  PNPM_DIRS+=("$PNPM_HOME")
fi

BIND_ARGS=()
bound=""

add_bind() {
  local path="$1" mode="${2:---bind}" real
  real="$(realpath -q "$path")" || return 0
  [ -e "$real" ] || return 0
  case ":$bound:" in *":$mode $real:"*) return 0 ;; esac
  bound="$bound:$mode $real"
  BIND_ARGS+=("$mode" "$real" "$real")
}

for dir in "${CACHE_DIRS[@]}"; do
  # Create a cache dir only when its tool is already installed, i.e. when the
  # parent exists, so pi-web-safe never litters $HOME for tools you do not use.
  parent="$(dirname "$dir")"
  if [ ! -d "$dir" ] && [ "$parent" != "$HOME" ] && [ -d "$parent" ]; then
    mkdir -p "$dir" 2>/dev/null || true
  fi
  add_bind "$dir"
done

# pnpm cannot run at all without these, so create them unconditionally.
for dir in "${PNPM_DIRS[@]}"; do
  mkdir -p "$dir" 2>/dev/null || true
  add_bind "$dir"
done

# Git worktrees and repo subdirectories: the real .git lives outside
# $PROJECT_DIR, and git refuses to commit without write access to it. Keep the
# parts git executes on the host read-only, so this cannot become a way out of
# the sandbox.
if git_common="$(git -C "$PROJECT_DIR" rev-parse --git-common-dir 2>/dev/null)"; then
  git_common="$(cd "$PROJECT_DIR" && realpath -q "$git_common")" || git_common=""
  if [ -n "$git_common" ] && [ "${git_common#"$PROJECT_DIR"/}" = "$git_common" ]; then
    mkdir -p "$git_common/hooks" 2>/dev/null || true
    add_bind "$git_common"
    add_bind "$git_common/hooks" --ro-bind
    add_bind "$git_common/config" --ro-bind
  fi
fi

# No bind is needed for $SSH_AUTH_SOCK: connecting to a unix socket works
# through the read-only bind of /, so a forwarded agent is already reachable.

BWRAP_ARGS=(
  --ro-bind / /
  --dev-bind /dev/null /dev/null
  --dev-bind /dev/urandom /dev/urandom
  --tmpfs /tmp
)

if [[ -d /etc/ssh/ssh_config.d ]]; then
  BWRAP_ARGS+=(--tmpfs /etc/ssh/ssh_config.d)
fi

# Binds go after --tmpfs /tmp, which would otherwise silently shadow any bind
# resolving under /tmp.
BWRAP_ARGS+=(
  "${BIND_ARGS[@]}"
  --bind "$PROJECT_DIR" "$PROJECT_DIR"
  --chdir "$PROJECT_DIR"
  --setenv PS1 "sandbox$ "
)

echo "pi-web-safe: sandboxed, writable project: $PROJECT_DIR"
echo "pi-web-safe: ~/.pi, ~/.gemini and build tool caches writable, /tmp tmpfs, everything else read-only"
echo "pi-web-safe: pick $PROJECT_DIR as the session cwd in the pi-web UI"

bwrap "${BWRAP_ARGS[@]}" pnpx "@agegr/pi-web@latest" --hostname 0.0.0.0 "$@"
